# Copiá este archivo a .env y completá los valores. Nunca commitees .env.

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/active_trace

# Firma de JWT: mínimo 32 caracteres aleatorios.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Cifrado AES-256 de PII: base64 urlsafe de exactamente 32 bytes.
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Cambiarla exige re-cifrar los datos: python -m app.db.rotate_encryption_key
ENCRYPTION_KEY=

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Autoregistro público (solo despliegues de una institución). Por defecto: false.
ALLOW_PUBLIC_REGISTER=false

# Opcionales
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# SQL_ECHO=false

# Moodle Web Services (integración)
# MOODLE_URL=
# MOODLE_TOKEN=
